# ============================================================
#  KABA — Configuration de PRODUCTION (hébergement mutualisé)
#  Copiez ce fichier en « .env » sur le serveur et remplissez
#  les valeurs marquées « À REMPLIR ».
# ============================================================

APP_NAME=KABA
APP_ENV=production
# Générez la clé sur le serveur avec : php artisan key:generate
# (ou copiez une clé « base64:... » générée localement)
APP_KEY=
APP_DEBUG=false
# ⚠️ L'URL PUBLIQUE réelle du site (avec https), sans slash final
APP_URL=https://votre-domaine.bj

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# ---------- Base de données MySQL (créée dans cPanel) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=À_REMPLIR_nom_de_la_base
DB_USERNAME=À_REMPLIR_utilisateur
DB_PASSWORD=À_REMPLIR_mot_de_passe

# ---------- Sessions / cache / files d'attente ----------
# « database » évite les soucis de permissions de fichiers sur mutualisé.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Mettez le domaine pour partager la session sur les sous-domaines (sinon null)
SESSION_DOMAIN=null
# ⚠️ En https, forcez les cookies sécurisés :
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ---------- E-mails (OBLIGATOIRE avant d'ouvrir aux utilisateurs) ----------
# Sans SMTP fonctionnel, un membre qui oublie son mot de passe reste bloqué
# définitivement, et la confirmation d'adresse ne marche pas.
# Après configuration, VÉRIFIEZ avec :  php artisan kaba:mail-test vous@exemple.com
MAIL_MAILER=smtp
MAIL_HOST=À_REMPLIR_smtp
MAIL_PORT=465
MAIL_USERNAME=À_REMPLIR
MAIL_PASSWORD=À_REMPLIR
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@votre-domaine.bj
MAIL_FROM_NAME="${APP_NAME}"

# Exemples de configuration selon la solution retenue :
#
# 1) SMTP de l'hébergeur (cPanel > Comptes de messagerie) — le plus simple
#    MAIL_HOST=mail.votre-domaine.bj   MAIL_PORT=465   MAIL_ENCRYPTION=ssl
#    MAIL_USERNAME=no-reply@votre-domaine.bj  (l'adresse complète, pas le préfixe)
#
# 2) Brevo — offre gratuite ~300 e-mails/jour, meilleure délivrabilité
#    MAIL_HOST=smtp-relay.brevo.com   MAIL_PORT=587   MAIL_ENCRYPTION=tls
#
# 3) Gmail — dépannage seulement (limites basses, mot de passe d'application requis)
#    MAIL_HOST=smtp.gmail.com   MAIL_PORT=587   MAIL_ENCRYPTION=tls
#
# ⚠ MAIL_FROM_ADDRESS doit appartenir à VOTRE domaine, jamais à gmail.com :
#   sinon les messages partent en indésirables. Pensez aussi aux
#   enregistrements SPF et DKIM dans votre zone DNS.

VITE_APP_NAME="${APP_NAME}"

# Facultatif : masquer les logs verbeux
LOG_CHANNEL=stack
LOG_LEVEL=error
